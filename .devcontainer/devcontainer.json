{
  "name": "Vexa Viral Private Admin",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Vexa Viral Admin",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "pip install -r requirements-admin.txt",
  "remoteUser": "vscode"
}
